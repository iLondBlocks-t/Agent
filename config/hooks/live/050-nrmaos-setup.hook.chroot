#!/bin/sh
set -eu

SOURCE_DIR=/usr/src/nrmaos
if [ ! -f "$SOURCE_DIR/CMakeLists.txt" ]; then
    echo "nrmaOS shell source is missing at $SOURCE_DIR" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    cmake g++ qt6-base-dev qt6-declarative-dev qt6-declarative-dev-tools

cmake -S "$SOURCE_DIR" -B /tmp/nrmaos-build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
cmake --build /tmp/nrmaos-build --parallel "$(nproc)"
DESTDIR=/ cmake --install /tmp/nrmaos-build

# This account is intentionally for the disposable local live session only.
if ! id nrma >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash nrma
fi
passwd --lock nrma

install -d -m 0755 /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-nrmaos-autologin.conf <<'EOF'
[Seat:*]
autologin-user=nrma
autologin-user-timeout=0
user-session=nrmaos
greeter-session=lightdm-gtk-greeter
EOF

install -d -m 0755 /usr/share/xsessions
cat > /usr/share/xsessions/nrmaos.desktop <<'EOF'
[Desktop Entry]
Name=nrmaOS
Comment=nrmaOS live desktop session
Exec=openbox-session
Type=Application
DesktopNames=nrmaOS
EOF

install -d -o nrma -g nrma -m 0750 /home/nrma/.config/openbox
cat > /home/nrma/.config/openbox/autostart <<'EOF'
#!/bin/sh
xsetroot -solid '#111827'
/usr/bin/nrmaos-shell >/home/nrma/nrma-shell.log 2>&1 &
EOF
chown nrma:nrma /home/nrma/.config/openbox/autostart
chmod 0750 /home/nrma/.config/openbox/autostart

# Remove temporary compiler tooling and caches. Runtime libraries remain through
# the explicitly installed Qt/QML packages in the live-build package list.
apt-get purge -y --auto-remove cmake g++ qt6-base-dev qt6-declarative-dev qt6-declarative-dev-tools
rm -rf /tmp/nrmaos-build "$SOURCE_DIR" /var/lib/apt/lists/*
unset DEBIAN_FRONTEND
